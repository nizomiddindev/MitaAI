    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameDirectory)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameDirectory)\BepInEx\interop\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameDirectory)\BepInEx\interop\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UIEffect"><HintPath>$(GameDirectory)\BepInEx\interop\UIEffect.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameDirectory)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
