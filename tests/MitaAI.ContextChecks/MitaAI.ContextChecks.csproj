<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <MitaAITestFramework Condition="'$(MitaAITestFramework)' == ''">net10.0</MitaAITestFramework>
    <TargetFramework>$(MitaAITestFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure snapshot rules only; the Unity collector is compiled with the plugin. -->
    <Compile Include="../../src/MitaAI.Plugin/GameContextSnapshot.cs" Link="GameContextSnapshot.cs" />
  </ItemGroup>
</Project>
